@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
System_Ext(sensors, "Sensor Fleet", "Publishes timestamped temperature and location readings")
Person(operator, "Operations User", "Monitors current conditions and historical trends")
System(monitoring, "IoT Monitoring System", "Ingests telemetry and provides realtime and historical dashboards")
Rel(sensors, monitoring, "Publishes readings", "MQTT")
Rel(operator, monitoring, "Views heatmap and historical dashboard", "HTTPS")
@enduml
