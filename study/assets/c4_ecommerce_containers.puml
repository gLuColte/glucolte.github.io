@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
Person(customer, "Customer", "Browses and places orders")
Person(manager, "Store Manager", "Manages catalogue and stock")
System_Ext(payment, "Payment Provider", "Processes payments")
System_Ext(warehouse, "Warehouse System", "Fulfils confirmed orders")
System_Ext(notification, "Notification Provider", "Sends customer messages")
System_Boundary(commerce, "eCommerce Platform") {
    Container(storefront, "Storefront", "Web/Mobile Application", "Supports product discovery, cart, checkout, and tracking")
    Container(admin, "Admin Portal", "Web Application", "Manages products, prices, and stock")
    Container(api, "Commerce API", "Application Service", "Authenticates and routes customer and manager requests")
    Container(catalogue, "Catalogue Service", "Application Service", "Owns product data and search projections")
    Container(cart, "Cart Service", "Application Service", "Owns user-scoped mutable carts")
    Container(inventory, "Inventory Service", "Application Service", "Owns available and reserved stock")
    Container(order, "Order Service", "Application Service", "Coordinates checkout and owns order lifecycle")
    ContainerDb(catalogueData, "Catalogue Store", "Document Store + Search Index", "Stores products and searchable projections")
    ContainerDb(cartData, "Cart Store", "Key-Value Store", "Stores user-scoped carts")
    ContainerDb(inventoryData, "Inventory Database", "Relational Database", "Stores authoritative stock quantities")
    ContainerDb(orderData, "Order Database", "Relational Database", "Stores order and payment state")
    ContainerQueue(events, "Order Event Stream", "Durable Stream", "Carries committed order events")
    Container(worker, "Fulfillment Worker", "Event Consumer", "Sends confirmed orders and customer notifications")
}
Rel(customer, storefront, "Uses")
Rel(manager, admin, "Uses")
Rel(storefront, api, "Sends customer requests", "HTTPS")
Rel(admin, api, "Sends management requests", "HTTPS")
Rel(api, catalogue, "Searches and manages products")
Rel(api, cart, "Reads and changes cart")
Rel(api, order, "Starts checkout and reads orders")
Rel(order, inventory, "Reserves, confirms, or releases stock")
Rel(order, payment, "Authorizes and captures payment")
Rel(catalogue, catalogueData, "Reads/writes products and projections")
Rel(cart, cartData, "Reads/writes carts")
Rel(inventory, inventoryData, "Reads/writes stock")
Rel(order, orderData, "Reads/writes orders")
Rel(order, events, "Publishes OrderConfirmed")
Rel(events, worker, "Delivers order events")
Rel(worker, warehouse, "Submits fulfillment request")
Rel(worker, notification, "Sends confirmation and updates")
@enduml
