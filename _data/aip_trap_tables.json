[
  {
    "id": "aip-table-1",
    "title": "Model and prompt choices",
    "headers": [
      "Need",
      "Decision",
      "Check before choosing"
    ],
    "boundary_column": 2,
    "rows": [
      {
        "id": "trap-1-1",
        "stage": "Select",
        "band": "Observability",
        "domain": 1,
        "cells": [
          "A task needs a foundation model",
          "Compare supported models on representative held-out inputs",
          "Capability/modality, context and output limits, safety, latency, token cost, Region/API support. Public benchmark rank alone is insufficient."
        ]
      },
      {
        "id": "trap-1-2",
        "stage": "Adapt-RAG",
        "band": "none",
        "domain": 1,
        "cells": [
          "Private, current, or attributable knowledge",
          "Retrieve evidence into context",
          "Freshness, entitlement, candidate recall, context budget, and citation correctness."
        ]
      },
      {
        "id": "trap-1-3",
        "stage": "Adapt-Prompt",
        "band": "none",
        "domain": 1,
        "cells": [
          "Format, examples, or tone need adjustment",
          "Start with prompting and supported structured output",
          "Validate schema **and** factual/business meaning. Low temperature reduces variation; it does not guarantee truth or identical results."
        ]
      },
      {
        "id": "trap-1-4",
        "stage": "Adapt-FineTune",
        "band": "none",
        "domain": 1,
        "cells": [
          "Evaluated prompting is insufficient for stable behavior/style",
          "Consider supported customization",
          "Data quality, evaluation benefit, lifecycle cost, and deployment support. RAG and customization can combine."
        ]
      },
      {
        "id": "trap-1-5",
        "stage": "Adapt-Prompt",
        "band": "none",
        "domain": 1,
        "cells": [
          "Versioned reusable instructions",
          "Bedrock Prompt Management",
          "Templates, variables, variants, versions, and reproducible configuration. A version is not proof of approval or quality."
        ]
      },
      {
        "id": "trap-1-6",
        "stage": "Adapt-Prompt",
        "band": "none",
        "domain": 2,
        "cells": [
          "Visual prompt → retrieval → tool/condition chain",
          "Bedrock Flows",
          "Supported typed nodes and branching; use an agent when the model must select the next action."
        ]
      },
      {
        "id": "trap-1-7",
        "stage": "Adapt-Prompt",
        "band": "none",
        "domain": 2,
        "cells": [
          "Common supported-model chat API",
          "`Converse` / `ConverseStream`",
          "The application supplies relevant message history; the inference call is not a persistent conversation store. `InvokeModel` can also implement chat with a model-specific contract."
        ]
      }
    ]
  },
  {
    "id": "aip-table-2",
    "title": "Compute, orchestration, and recovery",
    "headers": [
      "Responsibility",
      "Strong candidate",
      "Boundary / runner-up"
    ],
    "boundary_column": 2,
    "rows": [
      {
        "id": "trap-2-1",
        "stage": "Constraint",
        "band": "none",
        "domain": 2,
        "cells": [
          "One bounded stateless operation",
          "Lambda",
          "Externalize durable state. A conventional invocation is limited to 15 minutes; long waits need a workflow or suitable compute."
        ]
      },
      {
        "id": "trap-2-2",
        "stage": "Constraint",
        "band": "none",
        "domain": 2,
        "cells": [
          "Long-lived/custom runtime or complex MCP service",
          "ECS/Fargate where the runtime fits",
          "A persistent connection/process is different from external session state. GPU/host-specific requirements need suitable hosting."
        ]
      },
      {
        "id": "trap-2-3",
        "stage": "Constraint",
        "band": "none",
        "domain": 2,
        "cells": [
          "Known durable sequence, branches, retries, approval",
          "Step Functions",
          "Developers control the states; complexity alone is not a reason to add orchestration."
        ]
      },
      {
        "id": "trap-2-4",
        "stage": "Constraint",
        "band": "none",
        "domain": 2,
        "cells": [
          "Model-selected tools based on observations",
          "Bedrock Agents or a framework such as Strands",
          "Limit tools, caller scope, parameters, iterations, time, and tokens. AgentCore Runtime hosts an agent; the agent implementation or managed harness owns its tool-selection loop. Neither replaces business authorization."
        ]
      },
      {
        "id": "trap-2-5",
        "stage": "Constraint",
        "band": "Security",
        "domain": 2,
        "cells": [
          "Dynamic diagnosis followed by controlled action",
          "Bounded agent → validated proposal → Step Functions",
          "The business API still enforces authorization, approval, and idempotency."
        ]
      },
      {
        "id": "trap-2-6",
        "stage": "Deploy",
        "band": "none",
        "domain": 2,
        "cells": [
          "Absorb bursts and pace workers",
          "SQS",
          "Queue age, visibility timeout, DLQ, retries, and rate control matter. Concurrency alone is not a model token-rate limit."
        ]
      },
      {
        "id": "trap-2-7",
        "stage": "Deploy",
        "band": "none",
        "domain": 2,
        "cells": [
          "Route events to independent targets",
          "EventBridge",
          "Add queues where consumers need buffering. A shared worker queue distributes work instead of independently broadcasting it to every consumer."
        ]
      }
    ]
  },
  {
    "id": "aip-table-3",
    "title": "Retrieval and knowledge boundaries",
    "headers": [
      "Need or symptom",
      "First decision",
      "Qualification"
    ],
    "boundary_column": 2,
    "rows": [
      {
        "id": "trap-3-1",
        "stage": "Adapt-RAG",
        "band": "none",
        "domain": 1,
        "cells": [
          "Managed ingestion, retrieval, and citations",
          "Bedrock Knowledge Bases with a supported store",
          "Custom chunking alone does not force custom RAG: supported Lambda transformations can supply it."
        ]
      },
      {
        "id": "trap-3-2",
        "stage": "Adapt-RAG",
        "band": "none",
        "domain": 1,
        "cells": [
          "Unsupported ranking/query behavior or pipeline control",
          "Custom orchestration with `Retrieve`, or custom retrieval",
          "Added control has development and operations cost."
        ]
      },
      {
        "id": "trap-3-3",
        "stage": "Adapt-RAG",
        "band": "none",
        "domain": 1,
        "cells": [
          "Semantic intent",
          "Vector retrieval",
          "Evaluate domain/language fit and candidate recall."
        ]
      },
      {
        "id": "trap-3-4",
        "stage": "Adapt-RAG",
        "band": "none",
        "domain": 1,
        "cells": [
          "Exact asset ID/SKU/policy code",
          "Exact lookup, lexical, or supported hybrid retrieval",
          "Preserve identifiers in searchable text/metadata. Hybrid is not universally superior."
        ]
      },
      {
        "id": "trap-3-5",
        "stage": "Adapt-RAG",
        "band": "none",
        "domain": 5,
        "cells": [
          "Wrong order, correct evidence in candidates",
          "Reranking",
          "Reorders existing candidates; adds latency/cost."
        ]
      },
      {
        "id": "trap-3-6",
        "stage": "Evaluate",
        "band": "Observability",
        "domain": 5,
        "cells": [
          "Correct evidence absent",
          "Check ingestion, freshness, ACLs/filters, query, chunking, and recall",
          "Reranking and a larger generator cannot recover unseen evidence."
        ]
      },
      {
        "id": "trap-3-7",
        "stage": "Data-Ingest",
        "band": "none",
        "domain": 1,
        "cells": [
          "Chunk boundaries lose context",
          "Evaluate chunking/overlap or parent-child retrieval",
          "Larger chunks can dilute precision and consume tokens; semantic chunking is not a universal default."
        ]
      },
      {
        "id": "trap-3-8",
        "stage": "Monitor",
        "band": "none",
        "domain": 1,
        "cells": [
          "Changed/deleted source still returned",
          "Verify completed sync/update/delete handling and derived copies",
          "An S3 update alone does not prove index refresh."
        ]
      },
      {
        "id": "trap-3-9",
        "stage": "Adapt-RAG",
        "band": "Security",
        "domain": 3,
        "cells": [
          "Multi-tenant knowledge",
          "Backend authorization → filter/ACL → retrieval",
          "The ingestion role's access does not authorize every caller to every vector."
        ]
      }
    ]
  },
  {
    "id": "aip-table-4",
    "title": "Data preparation gates",
    "headers": [
      "Input / requirement",
      "Candidate",
      "Boundary"
    ],
    "boundary_column": 2,
    "rows": [
      {
        "id": "trap-4-1",
        "stage": "Data-Prepare",
        "band": "none",
        "domain": 1,
        "cells": [
          "Scans, forms, tables",
          "Textract",
          "Preserve layout/table relationships and validate fields."
        ]
      },
      {
        "id": "trap-4-2",
        "stage": "Data-Prepare",
        "band": "none",
        "domain": 1,
        "cells": [
          "Recordings in a text pipeline",
          "Transcribe",
          "Preserve speaker turns; labels are not verified business roles. Check native audio support before requiring this intermediary."
        ]
      },
      {
        "id": "trap-4-3",
        "stage": "Data-Prepare",
        "band": "none",
        "domain": 1,
        "cells": [
          "Semantic structured extraction from supported media",
          "Bedrock Data Automation",
          "Projects/blueprints and S3 output; validate before database/index writes."
        ]
      },
      {
        "id": "trap-4-4",
        "stage": "Data-Prepare",
        "band": "Security",
        "domain": 1,
        "cells": [
          "Text entities or PII",
          "Comprehend or domain-specific detector",
          "Detection locates spans; apply and verify redaction before inference, storage, or indexing."
        ]
      },
      {
        "id": "trap-4-5",
        "stage": "Data-Prepare",
        "band": "none",
        "domain": 2,
        "cells": [
          "Lightweight normalization/schema validation",
          "Lambda/application code",
          "Preserve meaningful identifiers/case; Comprehend does not normalize arbitrary queries."
        ]
      },
      {
        "id": "trap-4-6",
        "stage": "Data-Prepare",
        "band": "none",
        "domain": 1,
        "cells": [
          "Dataset rules, ETL, catalogue",
          "Glue / Glue Data Quality",
          "Explicitly fail or quarantine invalid data; a quality report is not automatically a gate."
        ]
      }
    ]
  },
  {
    "id": "aip-table-5",
    "title": "Security and governance boundaries",
    "headers": [
      "Question",
      "Primary control",
      "Do not substitute"
    ],
    "boundary_column": 2,
    "rows": [
      {
        "id": "trap-5-1",
        "stage": "Constraint",
        "band": "Security",
        "domain": 3,
        "cells": [
          "Who is the caller?",
          "Cognito / appropriate federation",
          "Authentication is not document/tool entitlement."
        ]
      },
      {
        "id": "trap-5-2",
        "stage": "Constraint",
        "band": "Security",
        "domain": 3,
        "cells": [
          "Which actions/resources and business data may they use?",
          "IAM + application/data authorization",
          "Prompts and Guardrails do not enforce all tenant/business permissions."
        ]
      },
      {
        "id": "trap-5-3",
        "stage": "Adapt-Prompt",
        "band": "Security",
        "domain": 3,
        "cells": [
          "Which content risks should be filtered?",
          "Bedrock Guardrails + deterministic checks",
          "Configure supported input/output policies. Schema compliance does not establish factual correctness."
        ]
      },
      {
        "id": "trap-5-4",
        "stage": "Data-Prepare",
        "band": "Security",
        "domain": 3,
        "cells": [
          "Where is the sensitive data?",
          "**S3 discovery: Macie; text pipeline: Comprehend; model I/O: Guardrails**",
          "Detection is not verified redaction; filtered output does not sanitize all logs."
        ]
      },
      {
        "id": "trap-5-5",
        "stage": "Deploy",
        "band": "Security",
        "domain": 3,
        "cells": [
          "Must the API path be private?",
          "Interface VPC endpoint / PrivateLink, private DNS, network/endpoint policies",
          "A private subnet alone does not create the private service path."
        ]
      },
      {
        "id": "trap-5-6",
        "stage": "Deploy",
        "band": "Security",
        "domain": 3,
        "cells": [
          "How are bytes and secrets protected?",
          "KMS/encryption, TLS, Secrets Manager, least privilege",
          "Encryption does not establish entitlement, residency, or deletion."
        ]
      },
      {
        "id": "trap-5-7",
        "stage": "Constraint",
        "band": "Security",
        "domain": 3,
        "cells": [
          "Must permissions be limited across accounts or for a role?",
          "SCP / permissions boundary",
          "These limit applicable permissions; they do not grant them. Explicit denies and IAM evaluation still apply."
        ]
      },
      {
        "id": "trap-5-8",
        "stage": "Monitor",
        "band": "Security Observability",
        "domain": 3,
        "cells": [
          "Is resource configuration compliant?",
          "AWS Config rules for supported resources or custom checks",
          "Config does not inspect every model prompt."
        ]
      },
      {
        "id": "trap-5-9",
        "stage": "Monitor",
        "band": "Security Observability",
        "domain": 3,
        "cells": [
          "Suspicious behavior or aggregated findings?",
          "GuardDuty for supported threats; Security Hub for supported findings",
          "Neither is an inline content filter or a detector of every GenAI attack."
        ]
      }
    ]
  },
  {
    "id": "aip-table-6",
    "title": "Telemetry responsibilities",
    "headers": [
      "Question",
      "Evidence"
    ],
    "boundary_column": 1,
    "rows": [
      {
        "id": "trap-6-1",
        "stage": "Monitor",
        "band": "Security Observability",
        "domain": 3,
        "cells": [
          "Who called which AWS API, when, from where?",
          "**CloudTrail**, with required event coverage/selectors."
        ]
      },
      {
        "id": "trap-6-2",
        "stage": "Monitor",
        "band": "Security Observability",
        "domain": 3,
        "cells": [
          "What prompt/response produced this result?",
          "**Bedrock Model Invocation Logging**, explicitly enabled for supported calls and protected."
        ]
      },
      {
        "id": "trap-6-3",
        "stage": "Monitor",
        "band": "Observability",
        "domain": 4,
        "cells": [
          "Are latency, tokens, throttles, errors, or queue age changing?",
          "**CloudWatch metrics/alarms**; custom quality signals require evaluation/instrumentation."
        ]
      },
      {
        "id": "trap-6-4",
        "stage": "Monitor",
        "band": "Observability",
        "domain": 4,
        "cells": [
          "Which hop was slow or failed?",
          "Instrumented **X-Ray/OpenTelemetry spans**. Lambda tracing alone does not expose every SDK call or hidden model stage."
        ]
      },
      {
        "id": "trap-6-5",
        "stage": "Monitor",
        "band": "Observability",
        "domain": 5,
        "cells": [
          "Why did the agent choose/fail a tool?",
          "**Agent trace** + tool logs/workflow history, correlated by IDs. Persist required trace events; memory summaries are different evidence."
        ]
      },
      {
        "id": "trap-6-6",
        "stage": "Monitor",
        "band": "Observability",
        "domain": 4,
        "cells": [
          "Which prompt versions drive cost or unsafe responses across calls?",
          "**Logs Insights** over configured invocation/application logs."
        ]
      }
    ]
  },
  {
    "id": "aip-table-7",
    "title": "Residency decisions",
    "headers": [
      "Allowed processing",
      "Candidate",
      "Rejection test"
    ],
    "boundary_column": 2,
    "rows": [
      {
        "id": "trap-7-1",
        "stage": "Constraint",
        "band": "Security",
        "domain": 3,
        "cells": [
          "Exactly one approved Region",
          "In-Region inference",
          "Geographic/global profiles can process elsewhere."
        ]
      },
      {
        "id": "trap-7-2",
        "stage": "Constraint",
        "band": "Security",
        "domain": 3,
        "cells": [
          "Approved Regions inside one geography",
          "Eligible geographic profile, checking every destination",
          "An EU/US/APAC label is insufficient if only a subset of destinations is approved."
        ]
      },
      {
        "id": "trap-7-3",
        "stage": "Constraint",
        "band": "Security",
        "domain": 3,
        "cells": [
          "No geographic restriction",
          "Evaluate global/geographic profiles against capacity/cost/latency",
          "Global routing is not permitted by a geographic restriction."
        ]
      }
    ]
  },
  {
    "id": "aip-table-8",
    "title": "Serving and optimization choices",
    "headers": [
      "Objective",
      "Candidate",
      "Check / trade-off"
    ],
    "boundary_column": 2,
    "rows": [
      {
        "id": "trap-8-1",
        "stage": "Deploy",
        "band": "none",
        "domain": 4,
        "cells": [
          "Flexible intermittent traffic",
          "On-demand",
          "Quotas and throttling still apply."
        ]
      },
      {
        "id": "trap-8-2",
        "stage": "Deploy",
        "band": "none",
        "domain": 4,
        "cells": [
          "Stable measured token throughput",
          "Provisioned Throughput",
          "Hourly billing, support, sizing, commitment; no universal 60–70% break-even. Reservation alone does not guarantee lower p99."
        ]
      },
      {
        "id": "trap-8-3",
        "stage": "Deploy",
        "band": "none",
        "domain": 4,
        "cells": [
          "Offline S3 dataset",
          "Bedrock batch inference",
          "Model/Region support, job semantics, record reconciliation, completion objective. Avoid universal discount/latency claims."
        ]
      },
      {
        "id": "trap-8-4",
        "stage": "Deploy",
        "band": "none",
        "domain": 4,
        "cells": [
          "Earlier visible output",
          "Bedrock streaming + end-to-end transport",
          "Handle buffering, partial failure, and disconnects; streaming does not inherently make generation faster/cheaper."
        ]
      },
      {
        "id": "trap-8-5",
        "stage": "Deploy",
        "band": "Security",
        "domain": 4,
        "cells": [
          "Broader eligible compute pool",
          "Cross-Region profile",
          "Geographic controls and source-endpoint recovery remain separate."
        ]
      },
      {
        "id": "trap-8-6",
        "stage": "Select",
        "band": "none",
        "domain": 4,
        "cells": [
          "Simpler queries need less capability",
          "Intelligent Prompt Routing or custom routing/cascade",
          "Evaluate both query groups; native routing has model-pair/family restrictions. Custom logic does not inherently need Step Functions."
        ]
      }
    ]
  },
  {
    "id": "aip-table-9",
    "title": "Caching responsibilities",
    "headers": [
      "What repeats?",
      "Pattern",
      "Does a hit skip generation?"
    ],
    "boundary_column": 2,
    "rows": [
      {
        "id": "trap-9-1",
        "stage": "Adapt-Prompt",
        "band": "none",
        "domain": 4,
        "cells": [
          "Identical long prefix; questions differ",
          "**Bedrock prompt caching**",
          "No. Reuses supported prefix processing; verify checkpoints, TTL, hits, and billing."
        ]
      },
      {
        "id": "trap-9-2",
        "stage": "Deploy",
        "band": "Security",
        "domain": 4,
        "cells": [
          "Equivalent questions; answer remains valid",
          "**Semantic response caching**",
          "Yes. Calibrate similarity and test meaning, scope, freshness, and unsafe reuse."
        ]
      },
      {
        "id": "trap-9-3",
        "stage": "Deploy",
        "band": "Security",
        "domain": 4,
        "cells": [
          "Identical complete scoped input/configuration",
          "**Result fingerprinting / exact response cache**",
          "Yes, if a valid entry exists. Exact input does not guarantee a hit after expiry, eviction, or invalidation."
        ]
      }
    ]
  },
  {
    "id": "aip-table-10",
    "title": "Evaluation and troubleshooting",
    "headers": [
      "Defect / question",
      "Measure or inspect",
      "First response"
    ],
    "boundary_column": 2,
    "rows": [
      {
        "id": "trap-10-1",
        "stage": "Evaluate",
        "band": "Observability",
        "domain": 5,
        "cells": [
          "Relevant evidence missing",
          "Recall, ingestion status, filters, source versions",
          "Find the first missing boundary; fix retrieval before generation."
        ]
      },
      {
        "id": "trap-10-2",
        "stage": "Evaluate",
        "band": "Observability",
        "domain": 5,
        "cells": [
          "Retrieved context contains noise",
          "Context precision/relevance, ranking, chunk boundaries",
          "Evaluate retrieval/reranking/pruning while preserving evidence."
        ]
      },
      {
        "id": "trap-10-3",
        "stage": "Evaluate",
        "band": "Observability",
        "domain": 5,
        "cells": [
          "Answer invents claims despite evidence",
          "**Faithfulness** against supplied sources",
          "Test context use and grounding checks; a cited answer can still be false."
        ]
      },
      {
        "id": "trap-10-4",
        "stage": "Evaluate",
        "band": "Observability",
        "domain": 5,
        "cells": [
          "Answer does not address the question",
          "**Answer relevance**",
          "Check intent/task rubric; correctness and source support are distinct."
        ]
      },
      {
        "id": "trap-10-5",
        "stage": "Evaluate",
        "band": "Security Observability",
        "domain": 5,
        "cells": [
          "Fluent answer, wrong action",
          "Task completion, tool selection/parameters, authorization, idempotency",
          "Inspect actual outcomes/trace and enforce deterministic checks."
        ]
      },
      {
        "id": "trap-10-6",
        "stage": "Evaluate",
        "band": "Observability",
        "domain": 5,
        "cells": [
          "Large-scale semantic assessment",
          "Calibrated **LLM-as-a-judge**",
          "Explicit rubrics, human calibration, judge-error/bias checks."
        ]
      },
      {
        "id": "trap-10-7",
        "stage": "Evaluate",
        "band": "Observability",
        "domain": 5,
        "cells": [
          "High-risk judgment or reference labels",
          "Domain experts / humans",
          "Use guidelines and adjudication; human labels are not infallible."
        ]
      },
      {
        "id": "trap-10-8",
        "stage": "Evaluate",
        "band": "Observability",
        "domain": 5,
        "cells": [
          "Fast repeatable regressions",
          "Assertions and suitable automated metrics",
          "BLEU/ROUGE capture overlap, not semantic truth/tool correctness."
        ]
      }
    ]
  },
  {
    "id": "aip-table-11",
    "title": "Comparison, rollout, and validation",
    "headers": [
      "Method",
      "Purpose",
      "Control"
    ],
    "boundary_column": 2,
    "rows": [
      {
        "id": "trap-11-1",
        "stage": "Evaluate",
        "band": "Observability",
        "domain": 5,
        "cells": [
          "Offline comparison",
          "Compare before exposure",
          "Same held-out cases, sources, and rubric."
        ]
      },
      {
        "id": "trap-11-2",
        "stage": "Deploy",
        "band": "Observability",
        "domain": 5,
        "cells": [
          "A/B",
          "Compare live variants' outcomes",
          "Stable cohorts, attribution, sufficient evidence, prior safety gates. No mandatory 50/50 split."
        ]
      },
      {
        "id": "trap-11-3",
        "stage": "Deploy",
        "band": "none",
        "domain": 5,
        "cells": [
          "Canary deployment",
          "Limit rollout exposure",
          "Small live cohort, stop/rollback criteria, gradual promotion."
        ]
      },
      {
        "id": "trap-11-4",
        "stage": "Deploy",
        "band": "Security",
        "domain": 5,
        "cells": [
          "Shadow",
          "Compare mirrored requests without returning candidate output",
          "Isolate writes/side effects; duplicated inference still has data/cost implications."
        ]
      },
      {
        "id": "trap-11-5",
        "stage": "Deploy",
        "band": "none",
        "domain": 5,
        "cells": [
          "Blue/green",
