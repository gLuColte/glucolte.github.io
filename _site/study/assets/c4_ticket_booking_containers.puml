@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
Person(customer, "Customer", "Browses events and purchases tickets")
Person(organizer, "Event Organizer", "Creates and manages events")
System_Ext(paymentProvider, "Payment Provider", "Processes payment authorization and capture")
System_Ext(emailProvider, "Email Provider", "Delivers booking confirmation emails")
System_Boundary(ticketBookingSystem, "Ticket Booking System") {
    Container(customerApp, "Customer Web/Mobile App", "Web/Mobile", "Browse events, select seats, and purchase tickets")
    Container(organizerPortal, "Organizer Portal", "Web App", "Create and manage events and view bookings")
    Container(api, "Booking API", "Application Service", "Handles customer and organizer requests")
    Container(eventCatalog, "Event Catalog Service", "Application Service", "Manages events, venues, prices, and metadata")
    Container(inventoryService, "Seat Inventory Service", "Application Service", "Owns seat availability, holds, and reservations")
    Container(orderService, "Order Service", "Application Service", "Owns booking and order lifecycle")
    Container(paymentService, "Payment Service", "Application Service", "Coordinates payment authorization and capture")
    Container(notificationWorker, "Notification Worker", "Background Worker", "Sends booking confirmations asynchronously")
    ContainerDb(eventDb, "Event Database", "Relational Database", "Stores events, venues, pricing, and seat definitions")
    ContainerDb(inventoryDb, "Inventory Database", "Relational Database", "Stores seat state and temporary holds")
    ContainerDb(orderDb, "Order Database", "Relational Database", "Stores orders and payment state")
    ContainerQueue(eventQueue, "Event Queue", "Queue", "Carries booking-confirmed events")
}
Rel(customer, customerApp, "Uses")
Rel(organizer, organizerPortal, "Uses")
Rel(customerApp, api, "HTTPS")
Rel(organizerPortal, api, "HTTPS")
Rel(api, eventCatalog, "Reads and manages events")
Rel(api, inventoryService, "Checks and holds seats")
Rel(api, orderService, "Creates and retrieves orders")
Rel(eventCatalog, eventDb, "Reads/writes")
Rel(inventoryService, inventoryDb, "Reads/writes seat state")
Rel(orderService, inventoryService, "Confirms or releases seat hold")
Rel(orderService, paymentService, "Requests payment")
Rel(orderService, orderDb, "Reads/writes orders")
Rel(paymentService, paymentProvider, "Authorizes/captures payment")
Rel(orderService, eventQueue, "Publishes BookingConfirmed")
Rel(notificationWorker, eventQueue, "Consumes BookingConfirmed")
Rel(notificationWorker, emailProvider, "Sends confirmation email")
@enduml
